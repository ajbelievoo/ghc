# Application
APP_NAME=BelieVoo GHC
DEBUG=true

# Database
# SQLite (dev / legacy)
# DATABASE_URL=sqlite:///./believoo_dev.db
# PostgreSQL (production)
DATABASE_URL=postgresql://ghc_user:ghc_password@localhost:5432/ghc_production

# Security
SECRET_KEY=change-this-to-a-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@believoo.com
ADMIN_PASSWORD=admin123

# OVH Cloud API (get from https://api.ovh.com/createApp/)
OVH_ENDPOINT=ovh-ca
OVH_APPLICATION_KEY=your_app_key
OVH_APPLICATION_SECRET=your_app_secret
OVH_CONSUMER_KEY=your_consumer_key
OVH_SUBSIDIARY=CA

# Default markup
DEFAULT_MARGIN_PERCENT=20

# Payment Gateways (optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
CASHFREE_APP_ID=...
CASHFREE_SECRET_KEY=...
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYU_MERCHANT_KEY=...
PAYU_MERCHANT_SALT=...

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google OAuth (or set via Admin > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for transactional email (or set via Admin > Credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public site URL (payment redirects, email links)
SITE_URL=https://ghc.believoo.com

# Razorpay webhook secret (for signature verification)
RAZORPAY_WEBHOOK_SECRET=
